# Local PostgreSQL / ParadeDB
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/deep_agents_rag

# Required API keys
OPENAI_API_KEY=sk-your-openai-key
COHERE_API_KEY=your-cohere-key

# RAG defaults
RAG_ANSWER_MODEL=gpt-5-mini
RAG_TOP_K=10
RAG_HYBRID_CANDIDATE_TOP_K=50
RAG_EVAL_JUDGE_MODEL=gpt-4.1
RAG_EVAL_SEED=42
RAG_EVAL_SAMPLE_SIZE=20
RAG_EVAL_METRIC_THRESHOLD=0.5
RAG_RERANK_MODEL=rerank-english-v3.0

# Optional evaluation provider override
# RAG_JUDGE_API_KEY=your-judge-key
# RAG_JUDGE_BASE_URL=https://api.openai.com/v1
# RUN_RAG_EVAL=1

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_your-key
LANGSMITH_PROJECT=deep-agents-rag
